{
  "name": "geolibre-contour",
  "version": "0.3.7",
  "description": "GeoLibre plugin to add contour lines from a cloud-hosted DEM (COG) using maplibre-contour",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.geolibre.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package-geolibre-plugin.mjs",
    "serve": "node scripts/serve-geolibre-plugin.mjs"
  },
  "dependencies": {
    "geotiff": "^2.1.3",
    "geotiff-geokeys-to-proj4": "^2026.8.16",
    "maplibre-contour": "^0.1.0",
    "proj4": "^2.15.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^5.6.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "keywords": [
    "geolibre",
    "maplibre",
    "contour",
    "cog",
    "dem",
    "plugin"
  ],
  "author": "",
  "license": "MIT"
}
